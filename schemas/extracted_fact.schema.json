{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtractedFactSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_doc", "packet_id", "facts"],
  "properties": {
    "source_doc": {"enum": ["cv", "transcript"]},
    "packet_id": {"type": "string", "pattern": "^[0-9]{2}$"},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "subject", "claim", "source_span", "span_offset"],
        "properties": {
          "fact_id": {"type": "string"},
          "subject": {
            "type": "string",
            "pattern": "^(team_size|ownership|skill_claim|skill_demonstrated|tenure)_[a-z0-9_]+$"
          },
          "claim": {"type": "string"},
          "source_span": {"type": "string"},
          "span_offset": {
            "type": "array",
            "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  }
}
